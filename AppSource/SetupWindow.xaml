<Window x:Class="BeamMP_GUI.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BeamMP-GUI Setup &amp; Installer" Height="530" Width="660"
        MinHeight="530" MinWidth="660" MaxHeight="530" MaxWidth="660"
        ResizeMode="NoResize"
        Background="#111215" Foreground="#E2E8F0"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, Segoe UI Semibold, Arial">

    <Window.Resources>
        <!-- Primary Orange Button Style -->
        <Style x:Key="PrimaryButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#FF6600"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF7F24"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E05A00"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Slate Button Style -->
        <Style x:Key="SecondaryButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#22252C"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#333742"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2C303A"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#4B5160"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1A1C22"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark TextBox Style -->
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="#1B1E24"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="CaretBrush" Value="#FF6600"/>
            <Setter Property="BorderBrush" Value="#343844"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#4C5364"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF6600"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CheckBox Style -->
        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Location Card -->
            <RowDefinition Height="*"/>    <!-- Shortcuts Options Card -->
            <RowDefinition Height="Auto"/> <!-- Buttons Footer -->
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,18">
            <Border Width="40" Height="40" CornerRadius="8" Background="#FF6600" Margin="0,0,14,0">
                <TextBlock Text="⚡" FontSize="22" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="BEAMMP-GUI SETUP" FontWeight="Bold" FontSize="18" Foreground="#FFFFFF"/>
                <TextBlock Text="Configure server folder and install shortcuts" FontSize="12" Foreground="#8B949E"/>
            </StackPanel>
        </StackPanel>

        <!-- STEP 1: SERVER LOCATION -->
        <Border Grid.Row="1" Background="#181A20" BorderBrush="#2A2E38" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="BEAMMP SERVER LOCATION" FontSize="11" FontWeight="Bold" Foreground="#FF6600" Margin="0,0,0,4"/>
                <TextBlock Text="Choose the directory where your BeamMP-Server.exe and ServerConfig.toml are located:" FontSize="12" Foreground="#8B949E" Margin="0,0,0,10"/>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="txtServerPath" Grid.Column="0" Height="36" TextChanged="TxtServerPath_TextChanged"/>
                    <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Content="📂  Browse..." Height="36" Margin="8,0,0,0" Padding="14,0" Click="Browse_Click"/>
                </Grid>

                <!-- Validation Status Badge -->
                <Border x:Name="borderStatus" Background="#153E2B" BorderBrush="#10B981" BorderThickness="1" CornerRadius="4" Padding="10,4">
                    <TextBlock x:Name="lblStatus" Text="✓ BeamMP-Server.exe detected in this folder!" FontSize="11.5" FontWeight="SemiBold" Foreground="#34D399"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- STEP 2: SHORTCUTS (USER PICKS WHAT THEY WANT) -->
        <Border Grid.Row="2" Background="#181A20" BorderBrush="#2A2E38" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="SHORTCUTS &amp; PREFERENCES" FontSize="11" FontWeight="Bold" Foreground="#FF6600" Margin="0,0,0,4"/>
                <TextBlock Text="Choose which shortcuts and options you want:" FontSize="12" Foreground="#8B949E" Margin="0,0,0,12"/>

                <!-- Desktop Shortcut Option -->
                <Border Background="#131418" BorderBrush="#22252C" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                    <StackPanel>
                        <CheckBox x:Name="chkDesktop" Content="Create Desktop Shortcut" IsChecked="True"/>
                        <TextBlock Text="Adds a BeamMP-GUI shortcut on your Desktop for easy 1-click launch." FontSize="11" Foreground="#8B949E" Margin="22,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Start Menu Shortcut Option -->
                <Border Background="#131418" BorderBrush="#22252C" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                    <StackPanel>
                        <CheckBox x:Name="chkStartMenu" Content="Create Start Menu Shortcut" IsChecked="True"/>
                        <TextBlock Text="Adds BeamMP-GUI to your Windows Start Menu so you can search and pin it." FontSize="11" Foreground="#8B949E" Margin="22,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Launch After Setup Option -->
                <CheckBox x:Name="chkLaunchAfter" Content="Launch BeamMP-GUI immediately after setup" IsChecked="True" Margin="2,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- BUTTONS FOOTER -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="lblInstallProgress" Grid.Column="0" Text="" FontSize="12" Foreground="#38BDF8" VerticalAlignment="Center"/>

            <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Content="Cancel" Width="80" Height="42" Margin="0,0,10,0" Click="Cancel_Click"/>
            <Button x:Name="btnInstall" Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}" Content="🚀   Install &amp; Launch" Height="42" Click="Install_Click"/>
        </Grid>
    </Grid>
</Window>
