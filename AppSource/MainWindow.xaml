<Window x:Class="BeamMPServerManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BeamMP-GUI" Height="760" Width="1060"
        MinHeight="640" MinWidth="920"
        Background="#111215" Foreground="#E2E8F0"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, Segoe UI Semibold, Arial">

    <Window.Resources>
        <!-- Primary Orange Button Style -->
        <Style x:Key="PrimaryButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#FF6600"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF7F24"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E05A00"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#4A3828"/>
                                <Setter Property="Foreground" Value="#8A8A8A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Big Start Server Button -->
        <Style x:Key="BigStartButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#FF6600"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="24,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF7A1A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E65A00"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#3D3228"/>
                                <Setter Property="Foreground" Value="#777777"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Big Stop Server Button -->
        <Style x:Key="BigStopButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#EF4444"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="24,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#DC2626"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#B91C1C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Success Button Style -->
        <Style x:Key="SuccessButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#059669"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#047857"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Slate Button Style -->
        <Style x:Key="SecondaryButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#22252C"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#333742"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2C303A"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#4B5160"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1A1C22"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Console Preset Chip Button Style -->
        <Style x:Key="ConsolePresetButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#1A1E27"/>
            <Setter Property="Foreground" Value="#93C5FD"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Consolas, Segoe UI"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#2D3342"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#252D3D"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#60A5FA"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#191F2B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Navigation Tab Button Style -->
        <Style x:Key="NavButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1F2229"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark TextBox Style -->
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="#1B1E24"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="CaretBrush" Value="#FF6600"/>
            <Setter Property="BorderBrush" Value="#343844"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#4C5364"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF6600"/>
                                <Setter TargetName="border" Property="Background" Value="#20232B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark ComboBox Toggle Button Template -->
        <ControlTemplate x:Key="DarkComboBoxToggleButtonTemplate" TargetType="{x:Type ToggleButton}">
            <Border x:Name="templateRoot" Background="#1B1E24" BorderBrush="#343844" BorderThickness="1" CornerRadius="5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="30"/>
                    </Grid.ColumnDefinitions>
                    <Path x:Name="arrow" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="#8B949E" Data="M 0 0 L 4 4 L 8 0 Z" />
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="true">
                    <Setter TargetName="templateRoot" Property="BorderBrush" Value="#4C5364"/>
                    <Setter TargetName="arrow" Property="Fill" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="true">
                    <Setter TargetName="templateRoot" Property="BorderBrush" Value="#FF6600"/>
                    <Setter TargetName="arrow" Property="Fill" Value="#FF6600"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Dark ComboBoxItem Style -->
        <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Background" Value="#16181E"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="itemBorder" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}" Margin="1">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#2D323E"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#FF6600"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark ComboBox Style (Fixes white dropdown issue) -->
        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#1B1E24"/>
            <Setter Property="BorderBrush" Value="#343844"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <ToggleButton Name="ToggleButton" 
                                          Template="{StaticResource DarkComboBoxToggleButtonTemplate}" 
                                          Focusable="false"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                          ClickMode="Press" />
                            <ContentPresenter Name="ContentSite" 
                                              IsHitTestVisible="False" 
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="10,6,30,6"
                                              VerticalAlignment="Center" 
                                              HorizontalAlignment="Left">
                                <ContentPresenter.Resources>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                            <Popup Name="Popup" 
                                   Placement="Bottom" 
                                   IsOpen="{TemplateBinding IsDropDownOpen}" 
                                   AllowsTransparency="True" 
                                   Focusable="False" 
                                   PopupAnimation="Slide">
                                <Grid Name="DropDown" 
                                      SnapsToDevicePixels="True" 
                                      MinWidth="{TemplateBinding ActualWidth}" 
                                      MaxHeight="260">
                                    <Border x:Name="DropDownBorder" 
                                            Background="#16181E" 
                                            BorderThickness="1" 
                                            BorderBrush="#343844" 
                                            CornerRadius="6" 
                                            Padding="4" 
                                            Margin="0,4,0,0">
                                        <ScrollViewer SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern CheckBox Style -->
        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Header -->
            <RowDefinition Height="*"/>    <!-- Main Content Area -->
            <RowDefinition Height="Auto"/> <!-- Bottom Status Bar -->
        </Grid.RowDefinitions>

        <!-- ================= TOP HEADER BAR ================= -->
        <Border Grid.Row="0" Background="#16181D" BorderBrush="#262932" BorderThickness="0,0,0,1" Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- Logo & Title -->
                    <ColumnDefinition Width="*"/>    <!-- Navigation Tabs -->
                    <ColumnDefinition Width="Auto"/> <!-- Status Pill & Mods Button -->
                </Grid.ColumnDefinitions>

                <!-- Logo & Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- BeamMP Orange Accent Logo Graphic -->
                    <Border Width="32" Height="32" CornerRadius="6" Background="#FF6600" Margin="0,0,12,0">
                        <TextBlock Text="⚡" FontSize="18" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="BEAMMP" FontWeight="Bold" FontSize="16" Foreground="#FF6600" Margin="0,0,6,0"/>
                            <TextBlock Text="SERVER MANAGER" FontWeight="SemiBold" FontSize="16" Foreground="#FFFFFF"/>
                        </StackPanel>
                        <TextBlock Text="Control &amp; Config Suite" FontSize="11" Foreground="#8B949E"/>
                    </StackPanel>
                </StackPanel>

                <!-- Navigation Tabs (Center) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button x:Name="btnNavDashboard" Style="{StaticResource NavButtonStyle}" Content="⚡  Dashboard" Click="NavDashboard_Click" Margin="2,0"/>
                    <Button x:Name="btnNavConfig" Style="{StaticResource NavButtonStyle}" Content="⚙  Configuration Editor" Click="NavConfig_Click" Margin="2,0"/>
                    <Button x:Name="btnNavMods" Style="{StaticResource NavButtonStyle}" Content="📦  Client Mods" Click="NavMods_Click" Margin="2,0"/>
                </StackPanel>

                <!-- Status Pill & Quick Action Button -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Server Status Pill -->
                    <Border x:Name="borderStatusPill" Background="#1F2228" BorderBrush="#353A45" BorderThickness="1" CornerRadius="16" Padding="10,4" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="ellipseStatusDot" Width="8" Height="8" Fill="#EF4444" Margin="0,0,6,0"/>
                            <TextBlock x:Name="txtHeaderStatus" Text="OFFLINE" FontSize="11" FontWeight="Bold" Foreground="#EF4444"/>
                            <TextBlock x:Name="txtHeaderUptime" Text="" FontSize="11" Foreground="#9CA3AF" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Always-accessible Open Mods Folder Button -->
                    <Button x:Name="btnHeaderOpenMods" Style="{StaticResource SecondaryButtonStyle}" Content="📂  Open Mods Folder" Click="OpenModsFolder_Click" ToolTip="Open Resources/Client/ folder in Windows Explorer"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= MAIN CONTENT VIEWS ================= -->
        <Grid Grid.Row="1" Margin="18,14,18,10">

            <!-- ================= VIEW 1: DASHBOARD ================= -->
            <Grid x:Name="viewDashboard" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Top Hero Action Cards -->
                    <RowDefinition Height="*"/>    <!-- Live Server Console -->
                </Grid.RowDefinitions>

                <!-- TOP HERO ACTION CARDS -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.3*"/> <!-- Card 1: Start/Stop Server -->
                        <ColumnDefinition Width="1.0*"/> <!-- Card 2: Configuration Editor -->
                        <ColumnDefinition Width="1.0*"/> <!-- Card 3: Mods Directory -->
                    </Grid.ColumnDefinitions>

                    <!-- CARD 1: SERVER CONTROL -->
                    <Border Grid.Column="0" Background="#181A20" BorderBrush="#2A2E38" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,10,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="SERVER STATUS" FontSize="11" FontWeight="Bold" Foreground="#8B949E"/>
                            </StackPanel>

                            <!-- Big Start / Stop / Restart Controls -->
                            <StackPanel Grid.Row="1" Margin="0,0,0,14">
                                <!-- Start Server Button (Visible when stopped) -->
                                <Button x:Name="btnStartServer" Style="{StaticResource BigStartButtonStyle}" Content="▶   START SERVER" Height="48" Click="StartServer_Click"/>

                                <!-- Stop & Restart Buttons (Visible when running) -->
                                <Grid x:Name="panelRunningControls" Visibility="Collapsed" Height="48">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="btnStopServer" Grid.Column="0" Style="{StaticResource BigStopButtonStyle}" Content="⏹   STOP SERVER" Height="48" Click="StopServer_Click" Margin="0,0,8,0"/>
                                    <Button x:Name="btnRestartServer" Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Content="⟳ Restart" Height="48" Padding="14,0" Click="RestartServer_Click"/>
                                </Grid>
                            </StackPanel>

                            <!-- Quick Server Info Badges -->
                            <Border Grid.Row="2" Background="#121418" BorderBrush="#23262E" BorderThickness="1" CornerRadius="6" Padding="12,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="PORT" FontSize="10" FontWeight="Bold" Foreground="#6E7681"/>
                                        <TextBlock x:Name="lblDashPort" Text="30814" FontSize="13" FontWeight="SemiBold" Foreground="#F0F6FC"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="MAX PLAYERS" FontSize="10" FontWeight="Bold" Foreground="#6E7681"/>
                                        <TextBlock x:Name="lblDashPlayers" Text="8 Clients" FontSize="13" FontWeight="SemiBold" Foreground="#F0F6FC"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="ACTIVE MAP" FontSize="10" FontWeight="Bold" Foreground="#6E7681"/>
                                        <TextBlock x:Name="lblDashMap" Text="Italy" FontSize="13" FontWeight="SemiBold" Foreground="#F0F6FC" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- CARD 2: CONFIGURATION EDITOR -->
                    <Border Grid.Column="1" Background="#181A20" BorderBrush="#2A2E38" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,10,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="CONFIGURATION" FontSize="11" FontWeight="Bold" Foreground="#8B949E" Margin="0,0,0,8"/>

                            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                <TextBlock x:Name="lblDashServerName" Text="RemoFurt" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="Custom server rules, maps &amp; auth key" FontSize="12" Foreground="#8B949E" Margin="0,3,0,0"/>
                                <TextBlock x:Name="lblDashKeyStatus" Text="🔑 Auth Key: Configured" FontSize="11" Foreground="#10B981" Margin="0,6,0,0"/>
                            </StackPanel>

                            <Button Grid.Row="2" Style="{StaticResource SecondaryButtonStyle}" Height="40" Click="NavConfig_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚙" FontSize="14" Margin="0,0,8,0" Foreground="#FF6600"/>
                                    <TextBlock Text="Change Configuration" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- CARD 3: MODS DIRECTORY -->
                    <Border Grid.Column="2" Background="#181A20" BorderBrush="#2A2E38" BorderThickness="1" CornerRadius="10" Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="CLIENT MODS" FontSize="11" FontWeight="Bold" Foreground="#8B949E" Margin="0,0,0,8"/>

                            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                <TextBlock x:Name="lblDashModCount" Text="0 Mods Installed" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <TextBlock Text="Location: Resources/Client/" FontSize="12" Foreground="#8B949E" Margin="0,3,0,0"/>
                                <TextBlock x:Name="lblDashModSize" Text="Total size: 0 MB" FontSize="11" Foreground="#38BDF8" Margin="0,6,0,0"/>
                            </StackPanel>

                            <Button Grid.Row="2" Style="{StaticResource SecondaryButtonStyle}" Height="40" Click="OpenModsFolder_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📂" FontSize="14" Margin="0,0,8,0"/>
                                    <TextBlock Text="Open Mods Directory" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>

                <!-- LIVE INTERACTIVE SERVER CONSOLE -->
                <Border Grid.Row="1" Background="#14161C" BorderBrush="#242731" BorderThickness="1" CornerRadius="10" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Console Toolbar -->
                            <RowDefinition Height="*"/>    <!-- Console Output Text -->
                            <RowDefinition Height="Auto"/> <!-- Command Presets Bar -->
                            <RowDefinition Height="Auto"/> <!-- Command Input Bar -->
                        </Grid.RowDefinitions>

                        <!-- Console Toolbar -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="LIVE SERVER CONSOLE" FontSize="12" FontWeight="Bold" Foreground="#F0F6FC" Margin="0,0,12,0"/>
                                <Border Background="#1C1E24" CornerRadius="4" Padding="6,2">
                                    <TextBlock x:Name="txtConsoleLineCount" Text="0 lines" FontSize="11" Foreground="#8B949E"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox x:Name="chkAutoScroll" Content="Auto-scroll" IsChecked="True" Margin="0,0,14,0" Foreground="#8B949E"/>
                                <Button Content="Clear" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" FontSize="11" Click="ClearConsole_Click" Margin="0,0,6,0"/>
                                <Button Content="Copy All" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" FontSize="11" Click="CopyConsole_Click"/>
                            </StackPanel>
                        </Grid>

                        <!-- Console Output Display -->
                        <Border Grid.Row="1" Background="#0A0B0E" BorderBrush="#1C1F27" BorderThickness="1" CornerRadius="6" Padding="10">
                            <ScrollViewer x:Name="scrollConsole" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                <TextBox x:Name="txtConsoleOutput" Background="Transparent" Foreground="#D1D5DB"
                                         FontFamily="Consolas, Lucida Console, Courier New" FontSize="12.5"
                                         IsReadOnly="True" BorderThickness="0" TextWrapping="Wrap"
                                         AcceptsReturn="True" CaretBrush="#FF6600"/>
                            </ScrollViewer>
                        </Border>

                        <!-- Command Presets Bar -->
                        <Border Grid.Row="2" Background="#161920" BorderBrush="#252A36" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,8,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock Text="⚡ Quick Presets:" FontSize="11.5" FontWeight="Bold" Foreground="#FF6600"/>
                                </StackPanel>

                                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Button Style="{StaticResource ConsolePresetButtonStyle}" Content="status" ToolTip="Query server health, uptime &amp; active players" Click="PresetStatus_Click"/>
                                    <Button Style="{StaticResource ConsolePresetButtonStyle}" Content="list" ToolTip="List all connected players" Click="PresetList_Click"/>
                                    <Button Style="{StaticResource ConsolePresetButtonStyle}" Content="say &lt;msg&gt;" ToolTip="Broadcast a chat message to all players" Click="PresetSay_Click"/>
                                    <Button Style="{StaticResource ConsolePresetButtonStyle}" Content="kick &lt;name&gt;" ToolTip="Kick a player from the server" Click="PresetKick_Click"/>
                                    <Button Style="{StaticResource ConsolePresetButtonStyle}" Content="reloadmods" ToolTip="Reload all mods in Resources/Client folder without restarting" Click="PresetReloadMods_Click"/>
                                    <Button Style="{StaticResource ConsolePresetButtonStyle}" Content="version" ToolTip="Display server version info" Click="PresetVersion_Click"/>
                                    <Button Style="{StaticResource ConsolePresetButtonStyle}" Content="help" ToolTip="Show all available server commands" Click="PresetHelp_Click"/>
                                </WrapPanel>
                            </Grid>
                        </Border>

                        <!-- Interactive Command Input -->
                        <Grid Grid.Row="3" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text=">" FontSize="15" FontWeight="Bold" Foreground="#FF6600" VerticalAlignment="Center" Margin="4,0,10,0"/>

                            <TextBox x:Name="txtCommandInput" Grid.Column="1" Height="36" Padding="10,7" FontSize="13"
                                     ToolTip="Type a server command and press Enter (e.g., status, help, kick &lt;player&gt;)"
                                     KeyDown="CommandInput_KeyDown"/>

                            <Button Grid.Column="2" Content="Send" Style="{StaticResource PrimaryButtonStyle}" Height="36" Width="74" Margin="8,0,0,0" Click="SendCommand_Click"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ================= VIEW 2: DEDICATED CONFIGURATION EDITOR ================= -->
            <Grid x:Name="viewConfig" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Editor Header & Save Notification -->
                    <RowDefinition Height="*"/>    <!-- Form / Raw Editor Content -->
                </Grid.RowDefinitions>

                <!-- Config Editor Header -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Server Configuration Editor" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <Border x:Name="bannerSavedNotice" Background="#153E2B" BorderBrush="#10B981" BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="14,0,0,0" Visibility="Collapsed">
                                <TextBlock Text="✓ Configuration saved to ServerConfig.toml!" FontSize="12" FontWeight="SemiBold" Foreground="#34D399"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Edit and customize your BeamMP server settings. Changes save directly to ServerConfig.toml" FontSize="12" Foreground="#8B949E" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Top Action Buttons in Config View -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Switch Form / Raw View -->
                        <Button x:Name="btnToggleRawView" Style="{StaticResource SecondaryButtonStyle}" Content="🗎  View Raw TOML" Click="ToggleRawView_Click" Margin="0,0,8,0"/>
                        <!-- Reload Button -->
                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="↺  Reload" Click="ReloadConfig_Click" Margin="0,0,8,0" ToolTip="Discard unsaved changes and reload from file"/>
                        <!-- Save Button -->
                        <Button x:Name="btnSaveConfig" Style="{StaticResource SuccessButtonStyle}" Content="💾  Save Configuration" Click="SaveConfig_Click" Margin="0,0,8,0"/>
                        <!-- Back to Dashboard -->
                        <Button Style="{StaticResource PrimaryButtonStyle}" Content="⬅  Back to Dashboard" Click="NavDashboard_Click"/>
                    </StackPanel>
                </Grid>

                <!-- Visual Form Editor -->
                <ScrollViewer x:Name="scrollConfigForm" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <Grid Margin="0,0,10,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT COLUMN -->
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">

                            <!-- CARD: SERVER IDENTITY -->
                            <Border Background="#181A20" BorderBrush="#2A2E38" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="SERVER IDENTITY" FontSize="11" FontWeight="Bold" Foreground="#FF6600" Margin="0,0,0,12"/>

                                    <!-- Server Name -->
                                    <TextBlock Text="Server Name" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,4"/>
                                    <TextBox x:Name="cfgName" Margin="0,0,0,12"/>

                                    <!-- Description -->
                                    <TextBlock Text="Description" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,4"/>
                                    <TextBox x:Name="cfgDescription" Height="58" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,12"/>

                                    <!-- Tags -->
                                    <TextBlock Text="Tags (Comma separated, e.g. Freeroam, Drift, Racing)" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,4"/>
                                    <TextBox x:Name="cfgTags" Margin="0,0,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- CARD: GAMEPLAY & MAP -->
                            <Border Background="#181A20" BorderBrush="#2A2E38" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="GAMEPLAY &amp; MAP SELECTION" FontSize="11" FontWeight="Bold" Foreground="#FF6600" Margin="0,0,0,12"/>

                                    <!-- Map Preset Dropdown -->
                                    <TextBlock Text="Map Preset" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="comboMapPresets" SelectionChanged="ComboMapPresets_SelectionChanged" Margin="0,0,0,8" Height="34"/>

                                    <!-- Custom Map Path -->
                                    <TextBlock Text="Map Path (info.json file path)" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,4"/>
                                    <TextBox x:Name="cfgMap" Margin="0,0,0,14"/>

                                    <!-- Max Players & Max Cars -->
                                    <Grid Margin="0,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                            <TextBlock Text="Max Players (1 - 128)" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,4"/>
                                            <TextBox x:Name="cfgMaxPlayers" Text="8"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                            <TextBlock Text="Max Cars Per Player" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,4"/>
                                            <TextBox x:Name="cfgMaxCars" Text="1"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- CARD: MISCELLANEOUS & UPDATES -->
                            <Border Background="#181A20" BorderBrush="#2A2E38" BorderThickness="1" CornerRadius="8" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="UPDATES &amp; MAINTENANCE" FontSize="11" FontWeight="Bold" Foreground="#FF6600" Margin="0,0,0,12"/>

                                    <CheckBox x:Name="cfgImScaredOfUpdates" Content="Hide periodic server update reminder notices" Margin="0,0,0,12"/>

                                    <TextBlock Text="Update Reminder Interval (e.g. 30s, 10min, 1h, 1d, 30d)" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,4"/>
                                    <TextBox x:Name="cfgUpdateReminderTime" Text="30s"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- RIGHT COLUMN -->
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">

                            <!-- CARD: AUTHENTICATION & NETWORKING -->
                            <Border Background="#181A20" BorderBrush="#2A2E38" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="AUTHENTICATION &amp; NETWORK" FontSize="11" FontWeight="Bold" Foreground="#FF6600" Margin="0,0,0,12"/>

                                    <!-- AuthKey with Show/Hide toggle -->
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Auth Key (Required from Keymaster)" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0"/>
                                        <Button Grid.Column="1" Content="🔑 Get Keymaster Key" Style="{StaticResource SecondaryButtonStyle}" Padding="6,2" FontSize="11" Click="OpenKeymaster_Click"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="cfgAuthKey" Grid.Column="0" FontFamily="Consolas" Height="32"/>
                                        
                                        <!-- Sharp Vector Eye Icon Button (No emoji clipping) -->
                                        <Button x:Name="btnToggleAuthKeyMask" Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Width="38" Height="32" Margin="6,0,0,0" Click="ToggleAuthKeyMask_Click" ToolTip="Show/Hide AuthKey">
                                            <Path x:Name="iconAuthEye" Width="18" Height="14" Stretch="Uniform" Fill="#8B949E"
                                                  Data="M11.83,9L15,12.16C15,12.11 15,12.05 15,12A3,3 0 0,0 12,9C11.94,9 11.89,9 11.83,9M7.53,9.8L9.08,11.35C9.03,11.56 9,11.77 9,12A3,3 0 0,0 12,15C12.22,15 12.44,14.97 12.65,14.92L14.2,16.47C13.53,16.8 12.79,17 12,17A5,5 0 0,1 7,12C7,11.21 7.2,10.47 7.53,9.8M2,4.27L4.28,6.55L4.73,7C3.08,8.3 1.78,10 1,12C2.73,16.39 7,19.5 12,19.5C13.55,19.5 15.03,19.2 16.38,18.66L16.81,19.08L19.73,22L21,20.72L3.27,3M12,7A5,5 0 0,1 17,12C17,12.64 16.87,13.26 16.64,13.82L19.57,16.75C21.07,15.5 22.27,13.86 23,12C21.27,7.61 17,4.5 12,4.5C10.73,4.5 9.5,4.74 8.36,5.17L10.18,7C10.74,6.87 11.36,6.8 12,7Z"/>
                                        </Button>
                                    </Grid>

                                    <!-- Port & Bind IP -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                            <TextBlock Text="Server Port" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,4"/>
                                            <TextBox x:Name="cfgPort" Text="30814"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                            <TextBlock Text="Bind IP Address" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,4"/>
                                            <TextBox x:Name="cfgIP" Text="::"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Resource Folder -->
                                    <TextBlock Text="Resource Folder Path" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,4"/>
                                    <TextBox x:Name="cfgResourceFolder" Text="Resources"/>
                                </StackPanel>
                            </Border>

                            <!-- CARD: ACCESS, RULES & PRIVACY -->
                            <Border Background="#181A20" BorderBrush="#2A2E38" BorderThickness="1" CornerRadius="8" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="SERVER RULES &amp; VISIBILITY" FontSize="11" FontWeight="Bold" Foreground="#FF6600" Margin="0,0,0,12"/>

                                    <Border Background="#14151A" BorderBrush="#22252E" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                                        <StackPanel>
                                            <CheckBox x:Name="cfgPrivate" Content="Private Server" FontWeight="SemiBold"/>
                                            <TextBlock Text="Server will not be shown in the public server list. Direct connect only." FontSize="11" Foreground="#8B949E" Margin="22,2,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#14151A" BorderBrush="#22252E" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                                        <StackPanel>
                                            <CheckBox x:Name="cfgAllowGuests" Content="Allow Guest Players" FontWeight="SemiBold"/>
                                            <TextBlock Text="Allow players without a registered BeamMP account to join." FontSize="11" Foreground="#8B949E" Margin="22,2,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#14151A" BorderBrush="#22252E" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                                        <StackPanel>
                                            <CheckBox x:Name="cfgInformationPacket" Content="Information Packet" FontWeight="SemiBold"/>
                                            <TextBlock Text="Allow unconnected clients to query server info (player count, ping) without joining." FontSize="11" Foreground="#8B949E" Margin="22,2,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#14151A" BorderBrush="#22252E" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                                        <StackPanel>
                                            <CheckBox x:Name="cfgLogChat" Content="Log In-Game Chat" FontWeight="SemiBold"/>
                                            <TextBlock Text="Output and record player chat messages in the console and Server.log." FontSize="11" Foreground="#8B949E" Margin="22,2,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#14151A" BorderBrush="#22252E" BorderThickness="1" CornerRadius="6" Padding="12">
                                        <StackPanel>
                                            <CheckBox x:Name="cfgDebug" Content="Debug Logging" FontWeight="SemiBold"/>
                                            <TextBlock Text="Enable verbose diagnostic messages in console for troubleshooting." FontSize="11" Foreground="#8B949E" Margin="22,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- Raw TOML Text Editor View (Initially Collapsed) -->
                <Grid x:Name="gridRawTomlEditor" Grid.Row="1" Visibility="Collapsed" Margin="0,0,0,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#16181E" BorderBrush="#262A34" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                        <TextBlock Text="Editing ServerConfig.toml directly. Be careful with formatting and syntax." FontSize="12" Foreground="#E2E8F0"/>
                    </Border>

                    <Border Grid.Row="1" Background="#0C0D10" BorderBrush="#262A34" BorderThickness="1" CornerRadius="8" Padding="10">
                        <TextBox x:Name="txtRawToml" Background="Transparent" Foreground="#E2E8F0"
                                 FontFamily="Consolas, Lucida Console, Courier New" FontSize="13"
                                 BorderThickness="0" AcceptsReturn="True" AcceptsTab="True"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                    </Border>
                </Grid>
            </Grid>

            <!-- ================= VIEW 3: CLIENT MODS MANAGER ================= -->
            <Grid x:Name="viewMods" Visibility="Collapsed" AllowDrop="True" Drop="ViewMods_Drop" DragOver="ViewMods_DragOver">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header -->
                    <RowDefinition Height="Auto"/> <!-- Summary Bar -->
                    <RowDefinition Height="*"/>    <!-- Mods List -->
                    <RowDefinition Height="Auto"/> <!-- Drag & Drop Banner -->
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Client Mods Manager" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <TextBlock Text="Mods in Resources/Client/ are automatically synced and downloaded by players when joining" FontSize="12" Foreground="#8B949E" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="↺  Refresh" Click="RefreshMods_Click" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource PrimaryButtonStyle}" Content="📂  Open Mods Directory" Click="OpenModsFolder_Click"/>
                    </StackPanel>
                </Grid>

                <!-- Summary Bar -->
                <Border Grid.Row="1" Background="#181A20" BorderBrush="#2A2E38" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="INSTALLED MODS" FontSize="10" FontWeight="Bold" Foreground="#8B949E"/>
                            <TextBlock x:Name="lblModsSummaryCount" Text="0 Zip Files" FontSize="15" FontWeight="Bold" Foreground="#38BDF8"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="TOTAL SIZE" FontSize="10" FontWeight="Bold" Foreground="#8B949E"/>
                            <TextBlock x:Name="lblModsSummarySize" Text="0.00 MB" FontSize="15" FontWeight="Bold" Foreground="#10B981"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="Directory: Resources\Client\" FontSize="11" Foreground="#6E7681"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Mods List View -->
                <Border Grid.Row="2" Background="#14161C" BorderBrush="#242731" BorderThickness="1" CornerRadius="8" Padding="10">
                    <ListBox x:Name="lstMods" Background="Transparent" BorderThickness="0" Foreground="#E2E8F0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="{x:Type ListBoxItem}">
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="Margin" Value="0,2"/>
                                <Setter Property="Background" Value="#1A1C22"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#252832"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="📦" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding FileName}" FontWeight="SemiBold" FontSize="13" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding DisplaySize}" FontSize="12" Foreground="#38BDF8" VerticalAlignment="Center" Margin="14,0"/>
                                    <TextBlock Grid.Column="3" Text="{Binding DisplayDate}" FontSize="11" Foreground="#8B949E" VerticalAlignment="Center" Margin="14,0"/>
                                    <Button Grid.Column="4" Content="🗑 Delete" Style="{StaticResource SecondaryButtonStyle}" Padding="8,3" FontSize="11"
                                            Tag="{Binding FullPath}" Click="DeleteMod_Click"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <!-- Drag & Drop Zone -->
                <Border Grid.Row="3" Background="#181A20" BorderBrush="#353A47" BorderThickness="2"
                        CornerRadius="8" Padding="14" Margin="0,12,0,0">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="📥  Drag &amp; drop BeamNG / BeamMP mod .zip files here to install into Resources/Client/"
                                   HorizontalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="#8B949E"/>
                    </StackPanel>
                </Border>
            </Grid>

        </Grid>

        <!-- ================= BOTTOM STATUS FOOTER BAR ================= -->
        <Border Grid.Row="2" Background="#0E0F12" BorderBrush="#1C1F27" BorderThickness="0,1,0,0" Padding="18,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="BeamMP Server Directory: " FontSize="11" Foreground="#6E7681"/>
                    <TextBlock x:Name="lblFooterPath" Text="" FontSize="11" Foreground="#8B949E"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Ready" FontSize="11" Foreground="#10B981" x:Name="lblFooterStatus"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
